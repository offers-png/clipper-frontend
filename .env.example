# Existing public frontend configuration (no secret keys belong in VITE_* variables).
VITE_API_BASE=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Studio navigation is always visible; authentication remains required.
# VITE_ENABLE_STUDIOS is deprecated and no longer hides routes.
VITE_STUDIOS_API_BASE=http://localhost:8000/studios-api
# Local offline tools only on loopback hosts; ignored on deployed sites.
VITE_STUDIOS_LOCAL_ONLY=false
