# Existing public frontend configuration (no secret keys belong in VITE_* variables).
VITE_API_BASE=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# New Studios are opt-in. Existing application/authentication stays the default.
VITE_ENABLE_STUDIOS=false
VITE_STUDIOS_API_BASE=http://localhost:8000/studios-api
# Local offline tools only; false uses the existing ProtectedRoute.
VITE_STUDIOS_LOCAL_ONLY=false
